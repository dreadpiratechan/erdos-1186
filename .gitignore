# Lean build output and fetched dependencies (Mathlib is fetched by `lake exe cache get`)
lean/.lake/
# LaTeX intermediates (main.pdf, and main.bbl if present, are kept)
manuscript/*.aux
manuscript/*.blg
manuscript/*.log
manuscript/*.out
# Python build output
__pycache__/
*.pyc
# Generated by verification/make_upstream_pin.py on every run
verification/generated/
