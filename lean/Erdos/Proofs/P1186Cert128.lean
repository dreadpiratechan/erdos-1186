theorem T128_rowOK_all : ∀ i, 1 ≤ i → i ≤ 128 → T128.rowOK i = true := by
  intro i h1 h2
  rcases (show (1 ≤ i ∧ i < 41) ∨ (41 ≤ i ∧ i < 59) ∨ (59 ≤ i ∧ i < 74) ∨ (74 ≤ i ∧ i < 87) ∨ (87 ≤ i ∧ i < 99) ∨ (99 ≤ i ∧ i < 111) ∨ (111 ≤ i ∧ i < 123) ∨ (123 ≤ i ∧ i < 129) by omega) with h | h | h | h | h | h | h | h
  · exact List.all_eq_true.mp T128_chk_1 i (List.mem_range'_1.mpr h)
  · exact List.all_eq_true.mp T128_chk_41 i (List.mem_range'_1.mpr h)
  · exact List.all_eq_true.mp T128_chk_59 i (List.mem_range'_1.mpr h)
  · exact List.all_eq_true.mp T128_chk_74 i (List.mem_range'_1.mpr h)
  · exact List.all_eq_true.mp T128_chk_87 i (List.mem_range'_1.mpr h)
  · exact List.all_eq_true.mp T128_chk_99 i (List.mem_range'_1.mpr h)
  · exact List.all_eq_true.mp T128_chk_111 i (List.mem_range'_1.mpr h)
  · exact List.all_eq_true.mp T128_chk_123 i (List.mem_range'_1.mpr h)

/-- `d_i = dn_i / 1024` from the generated table. -/
def d128 (i : ℕ) : ℚ := ((T128.dnAt i : ℤ) : ℚ) / 1024

theorem cert128 : DiagCert 128 d128 := by
  have h := T128.diagCert (by norm_num [T128]) (by norm_num [T128]) T128_hdn T128_hlen
    (fun i hi => CertData.rowOK_sound T128 T128_rows_len i (T128_rowOK_all i (Finset.mem_Icc.mp hi).1 (Finset.mem_Icc.mp hi).2))
  have e : d128 = fun i => ((T128.dnAt i : ℤ) : ℚ) / ((T128.Q : ℤ) : ℚ) := by
    funext i; simp [d128, T128]
  rw [e]; exact h

theorem sum_d128 : ∑ i ∈ Icc 1 128, d128 i = 697849 / 512 := by
  have h : ∑ i ∈ Icc 1 128, d128 i = ((∑ i ∈ Icc 1 128, T128.dnAt i : ℤ) : ℚ) / 1024 := by
    simp only [d128]; rw [← Finset.sum_div]; push_cast; rfl
  rw [h, T128_dn_sum]; norm_num

theorem prsBound_d128 : prsBound 128 d128 = 3430919 / 67108864 := by
  rw [prsBound_of_sum 128 d128 (697849 / 512) sum_d128]
  norm_num

/-- The published PRS08 constant `1675/32768` is below the certified bound. -/
theorem prsBound_d128_ge : ((1675 : ℝ) / 32768) ≤ prsBound 128 d128 := by
  rw [prsBound_d128]; norm_num

