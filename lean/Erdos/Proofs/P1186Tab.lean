import Mathlib

/-! # Erdos 1186 - the table of the four constants `M_{uv}` of the Parrilo-Robertson-Saracino colouring

The PRS 12-block colouring of `[1, 548 k]` is the pull-back, along `x ↦ ⌈x / k⌉`, of the following colouring
`c1` of `[1, 548]` (blocks of sizes 28, 6, 28, 37, 59, 116, 116, 59, 37, 28, 6, 28, alternately `true`/`false`).
`cond3 u v A D` says that the coarse triple `(A + 1, A + D + u + 1, A + 2 D + v + 1)` lies in `[1, 548]` and is
monochromatic for `c1`.  `cntRange u v lo len` counts the good pairs `(A, D)` with `lo ≤ A < lo + len`, `D < 548`.
The four values needed by `Erdos.Proofs.P1186` are computed here by `decide +kernel`, in chunks small enough for
the kernel's memory.  (Generated by `problems/1186/out/gen_tab.py`; the values are also reproduced in Python.)
-/

namespace Erdos1186Day

/-- colour of the coarse position `x ∈ [1, 548]`: `true` on the even-indexed blocks
(block boundaries 28, 34, 62, 99, 158, 274, 390, 449, 486, 514, 520). -/
def c1 (x : ℕ) : Bool :=
  bif Nat.ble x 28 then true else bif Nat.ble x 34 then false else bif Nat.ble x 62 then true else
  bif Nat.ble x 99 then false else bif Nat.ble x 158 then true else bif Nat.ble x 274 then false else
  bif Nat.ble x 390 then true else bif Nat.ble x 449 then false else bif Nat.ble x 486 then true else
  bif Nat.ble x 514 then false else bif Nat.ble x 520 then true else false

def cond3 (u v A D : ℕ) : Bool :=
  Nat.ble (A + 2 * D + v + 1) 548 && (c1 (A + 1) == c1 (A + D + u + 1)) &&
    (c1 (A + 1) == c1 (A + 2 * D + v + 1))

/-- number of `D < m` with `cond3 u v A D`. -/
def cntD (u v A : ℕ) : ℕ → ℕ
  | 0 => 0
  | D + 1 => cntD u v A D + (bif cond3 u v A D then 1 else 0)

/-- number of good pairs `(A, D)` with `lo ≤ A < lo + len`, `D < 548`. -/
def cntRange (u v lo : ℕ) : ℕ → ℕ
  | 0 => 0
  | len + 1 => cntRange u v lo len + cntD u v (lo + len) 548

theorem cntRange_add (u v lo a b : ℕ) :
    cntRange u v lo (a + b) = cntRange u v lo a + cntRange u v (lo + a) b := by
  induction b with
  | zero => simp [cntRange]
  | succ b ih =>
    rw [← Nat.add_assoc, cntRange, cntRange, ih, Nat.add_assoc, Nat.add_assoc lo a b]

theorem cntRange_548 (u v : ℕ) :
    cntRange u v 0 548 = cntRange u v 0 100 + cntRange u v 100 100 + cntRange u v 200 100 +
      cntRange u v 300 100 + cntRange u v 400 100 + cntRange u v 500 48 := by
  have h : (548 : ℕ) = 100 + 100 + 100 + 100 + 100 + 48 := by norm_num
  rw [h, cntRange_add, cntRange_add, cntRange_add, cntRange_add, cntRange_add]

