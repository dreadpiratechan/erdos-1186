/-- **Kernel-checked MODEL2 certificate for `L = 256`**: `xᵀ C x ≥ -2190937/1024` on `[-1,1]^256` (shared `CubeLB`). -/
theorem cubeLB256 : CubeLB 256 (2190937 / 1024) := by
  have h := cubeLB_of_cert T256 (by show (0 : ℤ) < 4096; norm_num) (by show (0 : ℤ) < 268435456; norm_num)
    T256_rows_len T256_nrow_len T256_hlen T256_hdn
    T256_cuts_ok T256_acc T256_SM
    (fun i hi => T256_link_all i (Finset.mem_Icc.mp hi).1 (Finset.mem_Icc.mp hi).2)
    (fun i hi => T256_rowOK_all i (Finset.mem_Icc.mp hi).1 (Finset.mem_Icc.mp hi).2)
  have e : ((((∑ i ∈ Icc 1 T256.L, T256.dnAt i) + (T256.cuts.map Cut.mn).sum : ℤ) : ℚ) / (T256.Q : ℚ)) = 2190937 / 1024 := by
    rw [T256_sum]
    show ((8763748 : ℤ) : ℚ) / ((4096 : ℤ) : ℚ) = 2190937 / 1024
    norm_num
  rw [e] at h
  exact h

