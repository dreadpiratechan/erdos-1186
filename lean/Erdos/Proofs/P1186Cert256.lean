/-- `d_i = dn_i / 1024` from the generated table. -/
def d256 (i : ℕ) : ℚ := ((T256.dnAt i : ℤ) : ℚ) / 1024

theorem cert256 : DiagCert 256 d256 := by
  have h := T256.diagCert (by norm_num [T256]) (by norm_num [T256]) T256_hdn T256_hlen
    (fun i hi => CertData.rowOK_sound T256 T256_rows_len i (T256_rowOK_all i (Finset.mem_Icc.mp hi).1 (Finset.mem_Icc.mp hi).2))
  have e : d256 = fun i => ((T256.dnAt i : ℤ) : ℚ) / ((T256.Q : ℤ) : ℚ) := by
    funext i; simp [d256, T256]
  rw [e]; exact h

theorem sum_d256 : ∑ i ∈ Icc 1 256, d256 i = 1394087 / 256 := by
  have h : ∑ i ∈ Icc 1 256, d256 i = ((∑ i ∈ Icc 1 256, T256.dnAt i : ℤ) : ℚ) / 1024 := by
    simp only [d256]; rw [← Finset.sum_div]; push_cast; rfl
  rw [h, T256_dn_sum]; norm_num

theorem prsBound_d256 : prsBound 256 d256 = 6928985 / 134217728 := by
  rw [prsBound_of_sum 256 d256 (1394087 / 256) sum_d256]
  norm_num

/-- The published PRS08 constant `1675/32768` is below the certified bound. -/
theorem prsBound_d256_ge : ((1675 : ℝ) / 32768) ≤ prsBound 256 d256 := by
  rw [prsBound_d256]; norm_num

