-/

namespace Erdos1186Day

/-- Erdos problem 1186, the PRS conjecture `δ 3 = 117/2192`, as the claim's author proves it (unrefereed). -/
theorem erdos_1186.variants.prs_conjecture : δ 3 = 117 / 2192 :=
  Erdos1186Ex.delta3_eq_of_regions Erdos1186Ex.region1 Erdos1186Ex.region2 Erdos1186Ex.region3
    Erdos1186Ex.region4 Erdos1186Ex.region5

end Erdos1186Day

#print axioms Erdos1186Day.erdos_1186.variants.prs_conjecture
