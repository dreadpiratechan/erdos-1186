def Erdos1186Ex.StarOK : Prop :=
∃ C,
  ∀ (w : ℕ),
    1 ≤ w →
      -(5 / 137) * ↑(Erdos1186Ex.nn w) ^ 2 - C * ↑w ≤ ↑(Erdos1186Night2.Wm (Erdos1186Ex.sstar w) (Erdos1186Ex.nn w))
def Erdos1186Ex.BathOK : Erdos1186Ex.Grid → Prop :=
fun G =>
  ∃ C,
    ∀ (w : ℕ),
      1 ≤ w →
        ∀ (σ : ℕ → ℤ),
          Erdos1186Ex.IsInd σ →
            ∀ i < G.N,
              2 * ↑(Erdos1186Ex.nn w) ^ 2 * (↑(G.ai i) * G.yv w σ i + ↑(G.bi i) * G.yv w σ i ^ 2) - C * ↑w ≤
                ↑(∑ x ∈ G.cell w i, Erdos1186Ex.H2 w x * σ x)
def Erdos1186Ex.PairOK : Erdos1186Ex.Grid → Prop :=
fun G =>
  ∃ C,
    ∀ (w : ℕ),
      1 ≤ w →
        ∀ (σ : ℕ → ℤ),
          Erdos1186Ex.IsInd σ →
            ↑(Erdos1186Ex.nn w) ^ 2 *
                  ∑ i ∈ Finset.range G.N, ∑ j ∈ Finset.range G.N, G.pterm i j (G.yv w σ i) (G.yv w σ j) -
                C * ↑w ≤
              ↑(Erdos1186Ex.Qd (Erdos1186Ex.nn w) fun x => Erdos1186Ex.sstar w x * σ x)
def Erdos1186Ex.RegionLB : Erdos1186Ex.Grid → ℚ → ℚ → Prop :=
fun G lo hi => ∀ (y : ℕ → ℝ), (∀ i < G.N, 0 ≤ y i ∧ y i ≤ 1) → ↑lo ≤ G.mval y → G.mval y ≤ ↑hi → 0 ≤ G.Lval y
def Erdos1186Ex.Grid.Lval : Erdos1186Ex.Grid → (ℕ → ℝ) → ℝ :=
fun G y =>
  ∑ i ∈ Finset.range G.N, (↑(G.ai i) * y i + ↑(G.bi i) * y i ^ 2) +
    ∑ i ∈ Finset.range G.N, ∑ j ∈ Finset.range G.N, G.pterm i j (y i) (y j)
def Erdos1186Ex.Grid.pterm : Erdos1186Ex.Grid → ℕ → ℕ → ℝ → ℝ → ℝ :=
fun G i j yi yj =>
  have P := ↑(G.wt i) * ↑(G.wt j) * yi * yj;
  have Ain := ↑(G.A4 i j) / (4 * 1096 ^ 2);
  have Aout := ↑(G.wt i) * ↑(G.wt j) - Ain;
  if G.sgn i * G.sgn j = 1 then max 0 (P - Aout) else max (-Ain) (-P)
def Erdos1186Ex.Grid.mval : Erdos1186Ex.Grid → (ℕ → ℝ) → ℝ :=
fun G y => ∑ i ∈ Finset.range G.N, ↑(G.wt i) * y i
