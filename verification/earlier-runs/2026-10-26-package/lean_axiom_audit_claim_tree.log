def Erdos1186Day.monoCount : ℕ → ℕ → (ℕ → Bool) → ℕ :=
fun k n c ↦ {p ∈ Finset.Icc 1 n ×ˢ Finset.Icc 1 n | p.1 + (k - 1) * p.2 ≤ n ∧ ∀ i < k, c (p.1 + i * p.2) = c p.1}.card
def Erdos1186Day.minMonoCount : ℕ → ℕ → ℕ :=
fun k n ↦ sInf {m | ∃ c, Erdos1186Day.monoCount k n c = m}
def Erdos1186Day.δ : ℕ → ℝ :=
fun k ↦ Filter.liminf (fun n ↦ ↑(Erdos1186Day.minMonoCount k n) / ↑n ^ 2) Filter.atTop
